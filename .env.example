# Ping — example environment (copy to apps/server/.env and apps/web/.env,
# then fill in real values; never commit real secrets).
# Server vars are documented in apps/server/.env.example,
# web (build-time) vars in apps/web/.env.example.

# ─── Server (apps/server/.env) ───
PORT=5000
NODE_ENV=development
MONGODB_URI=mongodb://127.0.0.1:27017/ping
REDIS_URL=redis://127.0.0.1:6379/0
JWT_SECRET=
EMAIL_USER=
EMAIL_PASS=
CLIENT_URL1=http://localhost:5173
# CLIENT_URL2-4 are optional extra allowed origins (CORS + Socket.IO)
CLIENT_URL2=
CLIENT_URL3=
CLIENT_URL4=
SERVER_URL=http://localhost:5000
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_EMAIL=mailto:you@example.com
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# ─── Web (apps/web/.env, baked into the bundle at build time) ───
VITE_API_URL=http://localhost:5000
VITE_SOCKET_URL=http://localhost:5000
VITE_VAPID_PUBLIC_KEY=
VITE_WEBRTC_USERNAME=
VITE_WEBRTC_CREDENTIAL=
