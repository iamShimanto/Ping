# Ping web — copy to .env. These are build-time vars: they are baked into
# the JS bundle when you run `pnpm build`, so set them BEFORE building.
# If VITE_API_URL / VITE_SOCKET_URL are unset, API calls fall back to the
# web origin (same-origin) — set them explicitly for any real deploy.

VITE_API_URL=http://localhost:5000
VITE_SOCKET_URL=http://localhost:5000

# Web Push — same public key as the server's VAPID_PUBLIC_KEY
VITE_VAPID_PUBLIC_KEY=

# TURN relay credentials for WebRTC calls (see apps/web/src/hooks/useWebRTC.ts).
# NOTE: these ship inside the JS bundle, so use short-lived credentials.
VITE_WEBRTC_USERNAME=
VITE_WEBRTC_CREDENTIAL=
