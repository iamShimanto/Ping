# Ping server — copy to .env and fill in real values. Never commit .env.
# CLIENT_URL2-4 are optional; only CLIENT_URL1 is required.

PORT=5000
NODE_ENV=development

# Data
MONGODB_URI=mongodb://127.0.0.1:27017/ping
REDIS_URL=redis://127.0.0.1:6379/0

# Auth (access + refresh JWT signing)
JWT_SECRET=

# SMTP — welcome + password-reset emails via BullMQ.
# Host/port are configurable: defaults are Hostinger (smtp.hostinger.com:465,
# SSL). To reuse the MailFlyo mailbox instead, set SMTP_HOST=mail.byteflyo.shop
# SMTP_PORT=587 SMTP_SECURE=false (STARTTLS).
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_SECURE=true
EMAIL_USER=
EMAIL_PASS=

# Allowed frontend origins (CORS + Socket.IO). Only CLIENT_URL1 is required.
CLIENT_URL1=http://localhost:5173
CLIENT_URL2=
CLIENT_URL3=
CLIENT_URL4=

# Base URL of this server, used for OAuth callback URLs
SERVER_URL=http://localhost:5000

# Cloudinary — avatar + message media uploads
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Web Push (generate once: npx web-push generate-vapid-keys)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_EMAIL=mailto:you@example.com

# OAuth — register callback URLs as
#   ${SERVER_URL}/api/v1/auth/google/callback
#   ${SERVER_URL}/api/v1/auth/github/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
